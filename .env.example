# ============================================================
# SAMORAI · Variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore — NUNCA lo subas al repo.
# ============================================================

# --- Stripe (obligatorio para el checkout) ---
# Dashboard → Developers → API keys. Usa las claves de TEST mientras pruebas.
STRIPE_SECRET_KEY=sk_test_xxx

# Secret del endpoint de webhook.
#  · Local:    ejecuta `stripe listen --forward-to localhost:5173/api/stripe-webhook`
#              y copia el whsec_... que imprime.
#  · Producción: Dashboard → Developers → Webhooks → tu endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# (Opcional) Clave publicable, por si más adelante se usa Stripe.js en cliente.
# Debe llevar prefijo VITE_ para ser accesible desde el navegador.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- App ---
# URL base pública del sitio (para las return URLs de Stripe).
# Local: http://localhost:5173 · Producción: https://tudominio.com
SITE_URL=http://localhost:5173

# (Opcional · solo pruebas) Precio unitario en céntimos para variantes
# que aún no tengan `priceCents` en app/data/products.ts. Ej: 45000 = 450,00 €.
# Déjalo vacío en producción y pon precios reales en los datos de producto.
STRIPE_FALLBACK_PRICE_CENTS=

# --- Supabase (opcional · persistencia de pedidos) ---
# Si decides guardar pedidos en Supabase (ver app/lib/orders/schema.sql).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
