# ============================================================
# SAMORAI · Variables de entorno
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` está en .gitignore — NUNCA lo subas al repo.
# ============================================================

# --- Stripe (obligatorio para el checkout) ---
# Dashboard → Developers → API keys. Usa las claves de TEST mientras pruebas.
STRIPE_SECRET_KEY=sk_test_xxx

# Secret del endpoint de webhook.
#  · Local:    ejecuta `stripe listen --forward-to localhost:5173/api/stripe-webhook`
#              y copia el whsec_... que imprime.
#  · Producción: Dashboard → Developers → Webhooks → tu endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# (Opcional) Clave publicable, por si más adelante se usa Stripe.js en cliente.
# Debe llevar prefijo VITE_ para ser accesible desde el navegador.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Precios reales de Stripe (recomendado) ---
# IDs de los dos niveles de precio (price_...). NO son secretos.
# Créalos en Stripe (o con la CLI) como importes FINALES con IVA incluido:
#   · LOW  = 275,00 €  (ancho 8.5)
#   · HIGH = 300,00 €  (anchos 9 y 9.5)
# Si se dejan vacíos, el checkout usa price_data con el importe del servidor.
STRIPE_PRICE_ID_LOW=price_xxx
STRIPE_PRICE_ID_HIGH=price_xxx

# --- App ---
# URL base pública del sitio (para las return URLs de Stripe).
# Local: http://localhost:5173 · Producción: https://tudominio.com
SITE_URL=http://localhost:5173

# (Opcional · solo pruebas) Precio unitario en céntimos para variantes
# que aún no tengan `priceCents` en app/data/products.ts. Ej: 45000 = 450,00 €.
# Déjalo vacío en producción y pon precios reales en los datos de producto.
STRIPE_FALLBACK_PRICE_CENTS=

# --- Supabase (persistencia de pedidos) ---
# Ver app/lib/orders/schema.sql. La service_role es SECRETA (salta RLS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email de compra (Resend) ---
# RESEND_API_KEY: dashboard de Resend (secreta).
# EMAIL_FROM: remitente verificado, p.ej. "SAMORAI <pedidos@samoraiwheels.com>".
#   Para pruebas: onboarding@resend.dev (solo envía a tu propia dirección).
#   En PRODUCCIÓN debe ser el dominio propio verificado en Resend.
# SHOP_ORDER_EMAIL: destino del aviso interno de venta (el correo con el que
#   la empresa prepara y gestiona el pedido).
# CONTACT_EMAIL: destino del formulario de contacto
#   (por defecto isainzmorales@samoraiwheels.com si se deja vacío).
# Ambas admiten VARIAS direcciones separadas por comas.
RESEND_API_KEY=
EMAIL_FROM=
SHOP_ORDER_EMAIL=
CONTACT_EMAIL=

# ============================================================
# PRODUCCIÓN (Vercel → Settings → Environment Variables)
# Ver PRODUCTION.md para el checklist completo. En resumen:
#   · Claves y Price IDs de Stripe en modo LIVE (distintos de los de test).
#   · STRIPE_WEBHOOK_SECRET del endpoint creado en el dashboard, NO el de
#     `stripe listen`.
#   · SITE_URL con el dominio real y https://
#   · STRIPE_FALLBACK_PRICE_CENTS vacío.
# El servidor avisa en los logs de arranque si falta algo (app/lib/env.server.ts).
# ============================================================
